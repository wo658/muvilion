# Copy to .env.local (never commit real keys).

# ---- Model (OpenAI-compatible) ----
# MODEL_PROVIDER=meta            # meta (default) | baseten
MODEL_API_KEY=                   # Meta Model API key, format LLM|{id}|{secret}
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional second provider (MODEL_PROVIDER=baseten):
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# AGENT_LLM=stub                 # deterministic rule-based reviewer, no key needed
# AGENT_LLM_FALLBACK=off         # default: a failing model call falls back to the stub for that step

# ---- Engine (Python FastAPI) ----
ENGINE_URL=http://localhost:8000
ENGINE_MOCK=0                    # 1 = in-process deterministic mock engine (no Python needed)
# ENGINE_TIMEOUT_MS=30000        # validate/queue; layout = time_limit_s + this
# ENGINE_SIMULATE_TIMEOUT_MS=90000  # min; effective = max(this, max_wall_time_s + 30 s)

# ---- Kill switch & caps ----
LIVE_AGENT=off                   # must be "on" for live runs; otherwise the UI/route only replay the recording
AGENT_MAX_ITERATIONS=3           # revision iterations after the baseline
AGENT_MAX_FIX_ATTEMPTS=2         # validation-fix retries per iteration
AGENT_MAX_LLM_CALLS=20           # per run
AGENT_DAILY_RUN_CAP=50           # live runs per day (per server instance, in-memory)
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_RUN_TIMEOUT_S=280          # route maxDuration is 300

# ---- Run conditions (locked for the whole run) ----
# AGENT_TARGET_MAX_DENSITY=2.0   # p/m^2; stop when met with no validation errors
# AGENT_MIN_IMPROVEMENT=0.02     # relative; below this an iteration counts as "no improvement"
# AGENT_SCENARIO_KIND=entry      # entry | browse | exit
# AGENT_SCENARIO_AGENTS=200
# AGENT_SCENARIO_DURATION_S=300
# AGENT_SCENARIO_SEED=42
# AGENT_GRID_CELL=2
# AGENT_SIM_MAX_WALL_TIME_S=60   # SimulateRequest.max_wall_time_s; truncated runs are not comparable
# AGENT_LAYOUT_SEED=0
# AGENT_LAYOUT_TIME_LIMIT_S=10
