# Copy to .env.local (never commit real keys).

# ---- Model (OpenAI-compatible) ----
# MODEL_PROVIDER=meta            # meta (default) | baseten
MODEL_API_KEY=                   # Meta Model API key, format LLM|{id}|{secret}
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional second provider (MODEL_PROVIDER=baseten):
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# ---- Engine (Python FastAPI: drawing extraction) ----
ENGINE_URL=http://localhost:8000

# External booth applications are stored server-side using Node's built-in SQLite.
# Requires Node >=22.13 and a persistent local disk (one application host).
# Back up this file; do not put it in public/ or commit applicant data.
# For ephemeral/serverless or multiple hosts, supply a shared production data store
# before deployment. Public participant links use the app's currently served origin.
# BOOTH_DB_PATH=/absolute/persistent/path/booths.sqlite
# Optional layout/validation client settings (not used by Studio extraction):
# ENGINE_MOCK=1
# ENGINE_TIMEOUT_MS=30000

# Optional local SQLite data directory (default: web/data; keep private)
# MUVILION_DATA_DIR=/absolute/path/to/muvilion-data
