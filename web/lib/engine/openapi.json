{
  "openapi": "3.1.0",
  "info": {
    "title": "Booth Layout Engine",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/layout": {
      "post": {
        "tags": [
          "layout"
        ],
        "summary": "Layout",
        "operationId": "layout_layout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayoutResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/plans/extract": {
      "post": {
        "tags": [
          "plans"
        ],
        "summary": "Extract",
        "operationId": "extract_plans_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_plans_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanEvidence"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/validate": {
      "post": {
        "tags": [
          "validate"
        ],
        "summary": "Validate",
        "operationId": "validate_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_plans_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_plans_extract_post"
      },
      "Booth": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "W"
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "H"
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90
            ],
            "title": "Rotation",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "w",
          "h"
        ],
        "title": "Booth"
      },
      "BoothSpec": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "W"
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "H"
          },
          "popularity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Popularity",
            "default": 0.5
          },
          "kind": {
            "type": "string",
            "enum": [
              "booth",
              "tent",
              "food_truck",
              "kiosk"
            ],
            "title": "Kind",
            "default": "booth"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "w",
          "h"
        ],
        "title": "BoothSpec"
      },
      "Door": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "entrance",
              "exit",
              "emergency"
            ],
            "title": "Kind"
          },
          "a": {
            "$ref": "#/components/schemas/Point"
          },
          "b": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "a",
          "b"
        ],
        "title": "Door"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Layout": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "venue_id": {
            "type": "string",
            "title": "Venue Id"
          },
          "booths": {
            "items": {
              "$ref": "#/components/schemas/Booth"
            },
            "type": "array",
            "title": "Booths"
          }
        },
        "type": "object",
        "required": [
          "id",
          "venue_id",
          "booths"
        ],
        "title": "Layout"
      },
      "LayoutConstraints": {
        "properties": {
          "min_aisle_width": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Min Aisle Width",
            "default": 3.0
          },
          "door_clearance": {
            "type": "number",
            "minimum": 0.0,
            "title": "Door Clearance",
            "default": 5.0
          },
          "wall_margin": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wall Margin",
            "default": 1.0
          },
          "fixed": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "object",
            "title": "Fixed",
            "default": {}
          },
          "keep_out": {
            "items": {
              "$ref": "#/components/schemas/Rect"
            },
            "type": "array",
            "title": "Keep Out",
            "default": []
          },
          "popular_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Popular Threshold",
            "default": 0.8
          },
          "popular_door_distance": {
            "type": "number",
            "minimum": 0.0,
            "title": "Popular Door Distance",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "LayoutConstraints"
      },
      "LayoutRequest": {
        "properties": {
          "venue": {
            "$ref": "#/components/schemas/Venue"
          },
          "booths": {
            "items": {
              "$ref": "#/components/schemas/BoothSpec"
            },
            "type": "array",
            "title": "Booths"
          },
          "constraints": {
            "$ref": "#/components/schemas/LayoutConstraints",
            "default": {
              "min_aisle_width": 3.0,
              "door_clearance": 5.0,
              "wall_margin": 1.0,
              "fixed": {},
              "keep_out": [],
              "popular_threshold": 0.8,
              "popular_door_distance": 0.0
            }
          },
          "previous": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Layout"
              },
              {
                "type": "null"
              }
            ]
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 0
          },
          "time_limit_s": {
            "type": "number",
            "maximum": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Time Limit S",
            "default": 10.0
          }
        },
        "type": "object",
        "required": [
          "venue",
          "booths"
        ],
        "title": "LayoutRequest"
      },
      "LayoutResponse": {
        "properties": {
          "layout": {
            "$ref": "#/components/schemas/Layout"
          },
          "status": {
            "type": "string",
            "enum": [
              "optimal",
              "feasible",
              "infeasible"
            ],
            "title": "Status"
          },
          "objective": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objective"
          },
          "solve_time_s": {
            "type": "number",
            "title": "Solve Time S"
          }
        },
        "type": "object",
        "required": [
          "layout",
          "status",
          "solve_time_s"
        ],
        "title": "LayoutResponse"
      },
      "Obstacle": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "column",
              "restroom",
              "stage",
              "registration",
              "tree",
              "fountain",
              "structure",
              "other"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "minItems": 3,
            "title": "Polygon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "title": "Obstacle"
      },
      "PlanEvidence": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "source": {
            "$ref": "#/components/schemas/PlanSource"
          },
          "preview": {
            "type": "string",
            "title": "Preview"
          },
          "widthMeters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Widthmeters"
          },
          "heightMeters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heightmeters"
          },
          "scaleConfirmed": {
            "type": "boolean",
            "const": false,
            "title": "Scaleconfirmed",
            "default": false
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/PlanLine"
            },
            "type": "array",
            "maxItems": 100000,
            "title": "Lines"
          },
          "texts": {
            "items": {
              "$ref": "#/components/schemas/PlanText"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Texts"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "method": {
            "type": "string",
            "enum": [
              "pdf-vector",
              "opencv",
              "dxf"
            ],
            "title": "Method"
          }
        },
        "type": "object",
        "required": [
          "source",
          "preview",
          "lines",
          "texts",
          "warnings",
          "method"
        ],
        "title": "PlanEvidence"
      },
      "PlanLine": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "a": {
            "$ref": "#/components/schemas/PlanPoint"
          },
          "b": {
            "$ref": "#/components/schemas/PlanPoint"
          },
          "kind": {
            "type": "string",
            "enum": [
              "unknown",
              "wall",
              "dimension"
            ],
            "title": "Kind",
            "default": "unknown"
          },
          "origin": {
            "type": "string",
            "enum": [
              "vector",
              "raster",
              "cad"
            ],
            "title": "Origin"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "origin",
          "confidence"
        ],
        "title": "PlanLine"
      },
      "PlanPoint": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "PlanPoint"
      },
      "PlanSource": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "image",
              "dxf"
            ],
            "title": "Format"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "name",
          "format",
          "page",
          "pages",
          "width",
          "height"
        ],
        "title": "PlanSource"
      },
      "PlanText": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "x": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "x",
          "y"
        ],
        "title": "PlanText"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point"
      },
      "Rect": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "W"
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "H"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "title": "Rect"
      },
      "ValidateRequest": {
        "properties": {
          "venue": {
            "$ref": "#/components/schemas/Venue"
          },
          "layout": {
            "$ref": "#/components/schemas/Layout"
          },
          "constraints": {
            "$ref": "#/components/schemas/LayoutConstraints",
            "default": {
              "min_aisle_width": 3.0,
              "door_clearance": 5.0,
              "wall_margin": 1.0,
              "fixed": {},
              "keep_out": [],
              "popular_threshold": 0.8,
              "popular_door_distance": 0.0
            }
          }
        },
        "type": "object",
        "required": [
          "venue",
          "layout"
        ],
        "title": "ValidateRequest"
      },
      "ValidateResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "violations"
        ],
        "title": "ValidateResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Venue": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "setting": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ],
            "title": "Setting",
            "default": "indoor"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "obstacles": {
            "items": {
              "$ref": "#/components/schemas/Obstacle"
            },
            "type": "array",
            "title": "Obstacles",
            "default": []
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/Zone"
            },
            "type": "array",
            "title": "Zones",
            "default": []
          },
          "doors": {
            "items": {
              "$ref": "#/components/schemas/Door"
            },
            "type": "array",
            "minItems": 1,
            "title": "Doors"
          },
          "unknowns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknowns",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "width",
          "height",
          "doors"
        ],
        "title": "Venue"
      },
      "Violation": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "booth_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Booth Ids",
            "default": []
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "internal:geometry"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "message"
        ],
        "title": "Violation"
      },
      "Zone": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fire_lane",
              "lawn",
              "paved",
              "stage_front",
              "queue_area"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "minItems": 3,
            "title": "Polygon"
          },
          "buildable": {
            "type": "boolean",
            "title": "Buildable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "title": "Zone",
        "description": "Walkable ground area with its own rules (booths may not be placed on unbuildable zones)."
      }
    }
  }
}
