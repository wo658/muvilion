          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "violations"
        ],
        "title": "ValidateResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Venue": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "setting": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ],
            "title": "Setting",
            "default": "indoor"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "obstacles": {
            "items": {
              "$ref": "#/components/schemas/Obstacle"
            },
            "type": "array",
            "title": "Obstacles",
            "default": []
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/Zone"
            },
            "type": "array",
            "title": "Zones",
            "default": []
          },
          "doors": {
            "items": {
              "$ref": "#/components/schemas/Door"
            },
            "type": "array",
            "minItems": 1,
            "title": "Doors"
          },
          "unknowns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknowns",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "width",
          "height",
          "doors"
        ],
        "title": "Venue"
      },
      "Violation": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "booth_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Booth Ids",
            "default": []
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "internal:geometry"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "message"
        ],
        "title": "Violation"
      },
      "Zone": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fire_lane",
              "lawn",
              "paved",
              "stage_front",
              "queue_area"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "minItems": 3,
            "title": "Polygon"
          },
          "buildable": {
            "type": "boolean",
            "title": "Buildable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "polygon"
        ],
        "title": "Zone",
        "description": "Walkable ground area with its own rules (booths may not be placed on unbuildable zones)."
      }
    }
  }
