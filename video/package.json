{
  "name": "muvilion-motion-study",
  "version": "1.0.0",
  "description": "Ten-second plan, arrangement and 3D motion study",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts Muvilion-Space out/muvilion-space-10s.mp4 --concurrency=2",
    "render:atelier": "remotion render src/index.ts Muvilion-Atelier out/muvilion-atelier-10s.mp4 --concurrency=2",
    "render:inputs": "remotion render src/index.ts Muvilion-Input-Reveal out/muvilion-input-reveal-10s.mp4 --concurrency=2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
